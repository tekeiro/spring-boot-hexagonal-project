<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor
        xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.0.0 https://maven.apache.org/xsd/archetype-descriptor-1.0.0.xsd"
        name="${artifactId}">

    <modules>

        <module id="${rootArtifactId}-domain" dir="domain" name="${rootArtifactId}-domain">
            <fileSets>
                <fileSet filtered="true" packaged="true" encoding="UTF-8">
                    <directory>src/main/java</directory>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                </fileSet>
                <fileSet filtered="true" packaged="true" encoding="UTF-8">
                    <directory>src/test/java</directory>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                </fileSet>
            </fileSets>
        </module>

        <module id="${rootArtifactId}-application" dir="application" name="${rootArtifactId}-application">
            <fileSets>
                <fileSet filtered="true" packaged="true" encoding="UTF-8">
                    <directory>src/main/java</directory>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                </fileSet>
                <fileSet filtered="true" packaged="true" encoding="UTF-8">
                    <directory>src/test/java</directory>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                </fileSet>
            </fileSets>
        </module>

        <module id="${rootArtifactId}-utils" dir="utils" name="${rootArtifactId}-utils">
            <modules>
                <module id="${rootArtifactId}-commons" dir="commons" name="${rootArtifactId}-commons">
                    <fileSets>
                        <fileSet filtered="true" packaged="true" encoding="UTF-8">
                            <directory>src/main/java</directory>
                            <includes>
                                <include>**/*.java</include>
                            </includes>
                        </fileSet>
                        <fileSet filtered="true" packaged="true" encoding="UTF-8">
                            <directory>src/test/java</directory>
                            <includes>
                                <include>**/*.java</include>
                            </includes>
                        </fileSet>
                    </fileSets>
                </module>
            </modules>
        </module>

        <module id="${rootArtifactId}-infra" dir="infra" name="${rootArtifactId}-infra">
            <modules>
                <module id="${rootArtifactId}-api-rest" dir="inbound/api-rest" name="${rootArtifactId}-api-rest">
                    <fileSets>
                        <fileSet filtered="true" packaged="true" encoding="UTF-8">
                            <directory>src/main/java</directory>
                            <includes>
                                <include>**/*.java</include>
                            </includes>
                        </fileSet>
                        <fileSet filtered="true" packaged="true" encoding="UTF-8">
                            <directory>src/test/java</directory>
                            <includes>
                                <include>**/*.java</include>
                            </includes>
                        </fileSet>
                    </fileSets>
                </module>
                <module id="${rootArtifactId}-client-rest-external-service" dir="outbound/client-rest-external-service" name="${rootArtifactId}-client-rest-external-service">
                    <fileSets>
                        <fileSet filtered="true" packaged="true" encoding="UTF-8">
                            <directory>src/main/java</directory>
                            <includes>
                                <include>**/*.java</include>
                            </includes>
                        </fileSet>
                        <fileSet filtered="true" packaged="true" encoding="UTF-8">
                            <directory>src/test/java</directory>
                            <includes>
                                <include>**/*.java</include>
                            </includes>
                        </fileSet>
                    </fileSets>
                </module>
            </modules>
        </module>

        <module id="${rootArtifactId}-boot" dir="boot" name="${rootArtifactId}-boot">
            <fileSets>
                <fileSet filtered="true" packaged="true" encoding="UTF-8">
                    <directory>src/main/java</directory>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                </fileSet>
                <fileSet filtered="true" encoding="UTF-8">
                    <directory>src/main/resources</directory>
                    <includes>
                        <include>**/*.yml</include>
                        <include>**/*.yaml</include>
                        <include>**/*.properties</include>
                    </includes>
                </fileSet>
                <fileSet filtered="true" packaged="true" encoding="UTF-8">
                    <directory>src/test/java</directory>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                </fileSet>
            </fileSets>
        </module>

    </modules>
</archetype-descriptor>
